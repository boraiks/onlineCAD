#!/bin/sh
# Stamps js/version.js with the build number (commit count) and date, so the
# status bar shows which build a deployed page is running.
# Enable once per clone: git config core.hooksPath .githooks
count=$(git rev-list --count HEAD 2>/dev/null || echo 0)
build=$((count + 1))
today=$(date +%Y-%m-%d)

cat > js/version.js <<EOF
// Written by .githooks/pre-commit on every commit. Do not edit by hand.
(function (cad) {
  'use strict';
  cad.version = { number: '0.${build}', date: '${today}' };
})(window.WebCAD = window.WebCAD || {});
EOF
git add js/version.js
